# Copy to .env.local. Never commit credentials.
MONGODB_URI=mongodb://127.0.0.1:27017/archvista
AUTH_SECRET=
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set a strong, unique password (at least 14 characters) before admin:create.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Studio Administrator
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
NOTIFICATION_EMAIL=
# Only trust forwarded IP headers behind Vercel's trusted proxy.
TRUST_PROXY=false
# Optional self-hosted browser path for Playwright
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
