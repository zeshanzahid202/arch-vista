    "email:retry": "tsx --env-file=.env.local scripts/retry-email.ts"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.0",
    "@fontsource/manrope": "^5.2.0",
    "@hookform/resolvers": "^5.2.0",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "gsap": "^3.13.0",
    "lucide-react": "^0.468.0",
    "mongoose": "^9.0.0",
    "motion": "^12.23.0",
    "next": "^16.2.0",
    "next-auth": "5.0.0-beta.32",
    "smtp-mailer": "npm:nodemailer@^10.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.62.0",
