{
  "name": "archvista",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "config": {
    "mongodbMemoryServer": {
      "disablePostinstall": true
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
